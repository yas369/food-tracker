{
  "name": "plate-check",
  "version": "1.0.0",
  "private": true,
  "description": "Plate Check: a personal food tracker for Android",
  "scripts": {
    "sync": "cp node_modules/@capacitor/core/dist/capacitor.js www/ && cap sync android",
    "serve": "python3 -m http.server 8000 --directory www"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
